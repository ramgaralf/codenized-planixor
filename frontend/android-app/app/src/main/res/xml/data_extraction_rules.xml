<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) cloud backup rules.
    Excludes sensitive data (sync config with API keys) from automatic backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="planixor_database" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="planixor_database" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
