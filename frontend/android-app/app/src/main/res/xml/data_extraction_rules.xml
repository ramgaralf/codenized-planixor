<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) cloud backup and device transfer rules.
    Excludes sensitive data (sync config with API keys stored in DataStore).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
