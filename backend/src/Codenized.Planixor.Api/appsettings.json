{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Codenized.Core": "Warning",
      "Codenized.Planixor": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://*:80" }
    }
  },
  "ConnectionStrings": {
    "AppReadDb": "server=host.docker.internal;user id=dbuser;password=dbpwd;database=dbname",
    "AppWriteDb": "server=host.docker.internal;user id=dbuser;password=dbpwd;database=dbname"
  },
  "AppSettings": {
    "Product": "planixor",
    "Service": "api",
    "Friendly": "Codenized.Planixor",
    "Environment": "dev",
    "AllowSwagger": true
  },
  "SecuritySettings": {
    "ApiKeys": {
      "testuser": "4f034mWW3AyTAbMnQ1hqcwjq6xUNaBjUrn5aIkeYpwELHRnh0j"
    }
  },
  "HealthCheckSettings": {
    "StatusEndpoint": "/status",
    "HealthEndpoint": "/health",
    "ScanFrequency": 300000
  },
  "RateLimitSettings": {
    "Enabled": true,
    "AuthenticatedPermitLimit": 600,
    "AnonymousPermitLimit": 20,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6,
    "ExemptPathPrefixes": [ "/api/status", "/api/health" ]
  }
}
