{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Codenized.Core": "Warning",
      "Codenized.Planixor": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://*:80" }
    }
  },
  "ConnectionStrings": {
    "AppReadDb": "server=host.docker.internal;user id=dbuser;password=dbpwd;persistsecurityinfo=True;database=dbname",
    "AppWriteDb": "server=host.docker.internal;user id=dbuser;password=dbpwd;persistsecurityinfo=True;database=dbname"
  },
  "AppSettings": {
    "Product": "planixor",
    "Service": "api",
    "Friendly": "Codenized.Planixor",
    "Environment": "dev",
    "AllowSwagger": true
  }
}
