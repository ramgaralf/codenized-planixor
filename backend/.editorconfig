root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# SA1313: Record positional parameters use PascalCase intentionally (they define public properties for JSON serialization)
dotnet_diagnostic.SA1313.severity = none

# SA1010: False positive with C# 12+ collection expressions — StyleCop does not yet support the [] syntax
dotnet_diagnostic.SA1010.severity = none

# SA1009: False positive with C# 12+ collection expressions (closing paren before [])
dotnet_diagnostic.SA1009.severity = none

# SA1000: False positive with target-typed new() expressions in modern C#
dotnet_diagnostic.SA1000.severity = none

# AD0001: StyleCop SA1201 analyzer crashes on record declarations (known bug in StyleCop 1.1.x)
dotnet_diagnostic.SA1201.severity = none

# NU1903: Vulnerable NuGet packages — addressed separately in dependency update task
dotnet_diagnostic.NU1903.severity = none

# EF Core auto-generated migration files — do not edit manually
[**/Migrations/*.cs]
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1400.severity = none

# Unit test files — relaxed documentation and formatting rules
[**/UnitTest.*/**/*.cs]
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1117.severity = none
